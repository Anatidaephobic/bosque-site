---
import { siteConfig } from '../../data/site';
import Button from '../ui/Button.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Normalize path for active detection
const isCurrent = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="site-header" id="top-nav">
  <div class="container-wide header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label={`${siteConfig.name} - Página inicial`}>
      <img
        src={siteConfig.logo.src}
        alt={siteConfig.logo.alt}
        width={siteConfig.logo.width}
        height={siteConfig.logo.height}
        class="brand-logo"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Menu principal">
      <ul class="nav-list">
        {
          siteConfig.nav.map((item) => (
            <li class="nav-item">
              <a
                href={item.href}
                class:list={['nav-link', { active: isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <Button
        href={siteConfig.bookingUrl}
        variant="primary"
        size="sm"
        target="_blank"
        rel="noopener noreferrer"
        class="desktop-cta"
      >
        Fazer Reserva
      </Button>

      <!-- Hamburger Button (Accessible) -->
      <button
        type="button"
        class="hamburger-btn"
        id="mobile-menu-toggle"
        aria-label="Abrir menu de navegação"
        aria-controls="mobile-nav-drawer"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Offcanvas Drawer -->
  <div
    class="mobile-drawer"
    id="mobile-nav-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Navegação móvel"
    inert
  >
    <div class="drawer-backdrop" id="mobile-drawer-backdrop"></div>
    <div class="drawer-panel">
      <div class="drawer-header">
        <span class="drawer-title">{siteConfig.name}</span>
        <button
          type="button"
          class="btn-close"
          id="mobile-menu-close"
          aria-label="Fechar menu de navegação"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="drawer-nav" aria-label="Menu móvel">
        <ul class="drawer-list">
          {
            siteConfig.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={['drawer-link', { active: isCurrent(item.href) }]}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="drawer-footer">
        <Button
          href={siteConfig.bookingUrl}
          variant="primary"
          target="_blank"
          rel="noopener noreferrer"
          fullWidth
        >
          Fazer Reserva
        </Button>

        <div class="drawer-contact">
          <p class="contact-item">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
            </svg>
            <a href={`tel:${siteConfig.contact.phoneRaw}`}>{siteConfig.contact.phone}</a>
          </p>
          <p class="contact-item">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-nav-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');

    if (!toggleBtn || !drawer || !closeBtn || !backdrop) return;
    if (toggleBtn.dataset.menuInitialized === 'true') return;
    toggleBtn.dataset.menuInitialized = 'true';

    function openMenu() {
      drawer?.classList.add('is-open');
      drawer?.removeAttribute('inert');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeMenu() {
      drawer?.classList.remove('is-open');
      drawer?.setAttribute('inert', '');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggleBtn?.focus();
    }

    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('is-open');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    drawer.querySelectorAll('.drawer-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeMenu();
      }
    });
  }

  // Setup on initial page load and view transitions
  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-secondary); /* #114B5F deep slate teal / navy */
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    transition: background-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    height: 40px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.15));
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    color: rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.15);
  }

  .nav-link.active {
    background-color: var(--color-primary);
    color: var(--color-pine-dark);
    font-weight: var(--font-weight-semibold);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .desktop-cta {
    display: none;
  }

  @media (min-width: 900px) {
    .desktop-cta {
      display: inline-flex;
    }
  }

  .hamburger-btn {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 42px;
    height: 42px;
    padding: 11px 9px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius-md);
    cursor: pointer;
    color: #ffffff;
    transition: background-color var(--transition-fast);
  }

  .hamburger-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  @media (min-width: 900px) {
    .hamburger-btn {
      display: none;
    }
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transition: transform var(--transition-fast);
  }

  /* Offcanvas Drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    visibility: hidden;
    transition: visibility 0.3s ease;
  }

  .mobile-drawer.is-open {
    visibility: visible;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-drawer.is-open .drawer-backdrop {
    opacity: 1;
  }

  .drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 320px;
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer.is-open .drawer-panel {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .drawer-title {
    font-size: var(--font-size-h5);
    font-weight: var(--font-weight-semibold);
    color: var(--color-pine-dark);
  }

  .btn-close {
    background: transparent;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-close:hover {
    color: var(--color-text);
    background-color: var(--color-neutral-light);
  }

  .drawer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .drawer-link {
    display: block;
    padding: 0.75rem 1rem;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-regular);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: background-color var(--transition-fast);
  }

  .drawer-link:hover {
    background-color: var(--color-neutral-light);
  }

  .drawer-link.active {
    background-color: var(--color-primary);
    color: var(--color-pine-dark);
    font-weight: var(--font-weight-semibold);
  }

  .drawer-footer {
    margin-top: auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .drawer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
  }

  .contact-item a {
    color: var(--color-text);
  }

  .contact-item .icon {
    flex-shrink: 0;
    color: var(--color-primary);
  }
</style>
