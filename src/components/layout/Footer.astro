---
import { siteConfig } from '../../data/site';
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';

export interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
---

<footer class="site-footer cc-5" id="bottom">
  <div class="container footer-container">
    {
      showCta && (
        <div class="footer-cta-zone">
          <div class="cta-text">
            <h3 class="cta-heading">{siteConfig.footer.cta.heading}</h3>
            <p class="cta-subheading lead">{siteConfig.footer.cta.subheading}</p>
          </div>
          <div class="cta-action">
            <Button
              href={siteConfig.footer.cta.buttonUrl}
              variant="primary"
              size="lg"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-btn"
            >
              {siteConfig.footer.cta.buttonText}
            </Button>
          </div>
        </div>
      )
    }

    <hr class="footer-divider" />

    <div class="footer-info-grid">
      <!-- Address Block -->
      <div class="info-block address-block">
        <svg class="info-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
        </svg>
        <span class="info-text">{siteConfig.contact.address}</span>
      </div>

      <!-- Instagram Block -->
      <div class="info-block contact-link-block">
        <img class="info-icon" src="/images/instagram-glyph-gradient.svg" width="20" height="20" alt="" />
        <a href="https://www.instagram.com/portalbosquedasaguas/" target="_blank" rel="noopener noreferrer" class="info-link">
          @portalbosquedasaguas
        </a>
      </div>

      <!-- Email Block -->
      <div class="info-block contact-link-block">
        <svg class="info-icon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
          <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        <a href={`mailto:${siteConfig.contact.email}`} class="info-link">
          {siteConfig.contact.email}
        </a>
      </div>

      <!-- Phone / WhatsApp Block -->
      <div class="info-block contact-link-block">
        <WhatsAppIcon class="info-icon icon-whatsapp" width={20} height={20} />
        <a href={siteConfig.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="info-link">
          {siteConfig.contact.phone}
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p class="copyright">{siteConfig.footer.copyrightNotice}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-secondary); /* #114B5F deep slate teal / navy */
    color: var(--color-neutral-light);
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .footer-cta-zone {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
    padding-bottom: var(--space-8);
  }

  @media (min-width: 900px) {
    .footer-cta-zone {
      grid-template-columns: 1fr auto;
      gap: var(--space-8);
    }
  }

  .cta-heading {
    font-size: var(--font-size-h3);
    color: var(--color-surface);
    margin-bottom: var(--space-2);
  }

  .cta-subheading {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0;
  }

  .cta-action {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    flex-shrink: 0;
  }

  .cta-btn {
    min-width: 200px;
  }

  .footer-divider {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    margin-top: 0;
    margin-bottom: var(--space-8);
  }

  .footer-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: center;
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer-info-grid {
      grid-template-columns: 1fr auto;
    }
  }

  .info-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--font-size-base);
  }

  .address-block {
    color: rgba(255, 255, 255, 0.9);
  }

  .info-icon {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .info-icon.icon-whatsapp {
    color: #25D366;
  }

  .info-link {
    color: var(--color-neutral-light);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .info-link:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .copyright {
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0;
  }
</style>
