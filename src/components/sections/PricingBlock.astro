---
import Button from '../ui/Button.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { siteConfig } from '../../data/site';

export interface PriceItem {
  title: string;
  price: string;
  period?: string;
  note?: string;
  highlighted?: boolean;
}

export interface CTA {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'outline';
  isExternal?: boolean;
}

export interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  items: PriceItem[];
  extraNote?: string;
  footnote?: string;
  bgImage?: string;
  bgImageMobile?: string;
  bgParallax?: boolean;
  showTopWave?: boolean;
  cta?: CTA;
  secondaryCta?: CTA;
  class?: string;
}

const {
  badge,
  title,
  subtitle,
  items = [],
  extraNote = '+ R$50,00 para cada hóspede adicional, até o máximo de 5 pessoas',
  footnote = 'Consultar disponibilidade para eventos.',
  bgImage = '/images/pricing-bg-desktop.jpg',
  bgImageMobile,
  bgParallax = true,
  showTopWave = true,
  cta = {
    label: 'Reservar pelo WhatsApp',
    href: siteConfig.bookingUrl,
    variant: 'primary',
    isExternal: true,
  },
  secondaryCta,
  class: className = '',
} = Astro.props;
---

<section
  class:list={['pricing-section', { 'has-parallax': bgParallax }, className]}
  style={{
    '--pricing-bg-image': bgImage ? `url('${bgImage}')` : 'none',
    '--pricing-bg-image-mobile': bgImageMobile ? `url('${bgImageMobile}')` : (bgImage ? `url('${bgImage}')` : 'none'),
  }}
>
  {
    showTopWave && (
      <div class="pricing-wave-arch" aria-hidden="true">
        <svg class="pricing-wave-svg" viewBox="0 0 1440 60" preserveAspectRatio="none">
          <defs>
            <linearGradient id="pricing-wave-shadow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="rgba(0, 0, 0, 0.35)" />
              <stop offset="100%" stop-color="rgba(0, 0, 0, 0)" />
            </linearGradient>
          </defs>
          <path d="M0,0 C480,48 960,48 1440,0 L1440,60 L0,60 Z" fill="url(#pricing-wave-shadow)" />
          <path d="M0,0 L1440,0 L1440,0 C960,42 480,42 0,0 Z" fill="#114B5F" />
        </svg>
      </div>
    )
  }

  <div class="pricing-scrim"></div>

  <div class="container pricing-container">
    <div class="pricing-card reveal-on-scroll">
      {
        (badge || title || subtitle) && (
          <header class="pricing-header">
            {badge && <span class="pricing-badge">{badge}</span>}
            {title && <h2 class="pricing-title">{title}</h2>}
            {subtitle && <p class="pricing-subtitle lead">{subtitle}</p>}
          </header>
        )
      }

      <ul class="price-list">
        {
          items.map((item) => (
            <li class:list={['price-item', { highlighted: item.highlighted }]}>
              <div class="price-row">
                <span class="price-name">{item.title}</span>
                <span class="price-leader" aria-hidden="true" />
                <div class="price-value-box">
                  <span class="price-val"><u><strong>{item.price}</strong></u></span>
                  {item.period && <span class="price-period">{item.period}</span>}
                </div>
              </div>
              {item.note && <span class="price-item-note">{item.note}</span>}
            </li>
          ))
        }
      </ul>

      {
        extraNote && (
          <div class="price-extra-note">
            <svg class="note-icon" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </svg>
            <p><em>{extraNote}</em></p>
          </div>
        )
      }

      {footnote && <p class="price-footnote"><strong>{footnote}</strong></p>}

      {
        (cta || secondaryCta) && (
          <div class="pricing-actions">
            {cta && (
              <Button
                href={cta.href}
                variant={cta.variant || 'primary'}
                size="lg"
                target={cta.isExternal ? '_blank' : undefined}
                rel={cta.isExternal ? 'noopener noreferrer' : undefined}
                class="pricing-btn-booking"
              >
                <WhatsAppIcon class="btn-icon icon-whatsapp" width={18} height={18} />
                <span>{cta.label}</span>
              </Button>
            )}
            {secondaryCta && (
              <Button
                href={secondaryCta.href}
                variant={secondaryCta.variant || 'light'}
                size="lg"
                target={secondaryCta.isExternal ? '_blank' : undefined}
                rel={secondaryCta.isExternal ? 'noopener noreferrer' : undefined}
                class="pricing-btn-secondary"
              >
                <span>{secondaryCta.label}</span>
              </Button>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .pricing-section {
    position: relative;
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    background-color: var(--color-forest-green, #4C7C37);
    background-image: var(--pricing-bg-image);
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    overflow: hidden;
    min-height: 620px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .pricing-section {
      background-image: var(--pricing-bg-image-mobile);
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }

  .pricing-wave-arch {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    width: 100%;
    height: 52px;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
    line-height: 0;
  }

  .pricing-wave-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pricing-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(17, 75, 95, 0.45) 0%,
      rgba(14, 32, 18, 0.52) 30%,
      rgba(10, 24, 12, 0.70) 100%
    );
    z-index: 1;
  }

  .pricing-container {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    width: 100%;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .pricing-card {
    width: 100%;
    max-width: 680px;
    background: rgba(14, 30, 18, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 20px;
    padding: 2.5rem 2.5rem 2.25rem;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.05);
    color: var(--color-surface, #FFFFFF);
    text-align: center;
  }

  @media (max-width: 640px) {
    .pricing-card {
      padding: 1.75rem 1.25rem 1.5rem;
      border-radius: 16px;
    }
  }

  .pricing-header {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .pricing-badge {
    display: inline-block;
    padding: 0.25rem 0.85rem;
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: var(--font-weight-semibold, 600);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-pill, 9999px);
    background-color: var(--color-primary, #6CB14F);
    color: var(--color-pine-dark, #1C2E14);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .pricing-title {
    color: var(--color-surface, #FFFFFF);
    margin-bottom: var(--space-2, 0.5rem);
    font-size: var(--font-size-h2, 2rem);
  }

  .pricing-subtitle {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0;
  }

  .price-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: left;
  }

  .price-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .price-item:last-child {
    border-bottom: none;
    padding-bottom: 0.25rem;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .price-name {
    font-size: 1.2rem;
    font-weight: 500;
    color: #FFFFFF;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  @media (max-width: 480px) {
    .price-name {
      font-size: 1.05rem;
      white-space: normal;
    }
  }

  .price-leader {
    flex: 1;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.28);
    margin: 0 0.5rem;
    min-width: 1rem;
    transform: translateY(-4px);
  }

  .price-value-box {
    text-align: right;
    white-space: nowrap;
  }

  .price-val {
    font-size: 1.35rem;
    color: #FFFFFF;
  }

  .price-val u {
    text-decoration: underline;
    text-decoration-color: var(--color-primary, #6CB14F);
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .price-val strong {
    font-weight: 700;
    color: #FFFFFF;
  }

  @media (max-width: 480px) {
    .price-val {
      font-size: 1.2rem;
    }

    .price-leader {
      margin: 0;
    }
  }

  .price-period {
    font-size: var(--font-size-xs, 0.75rem);
    color: rgba(255, 255, 255, 0.75);
    display: block;
  }

  .price-item-note {
    font-size: var(--font-size-xs, 0.75rem);
    color: rgba(255, 255, 255, 0.75);
    font-style: italic;
  }

  .price-extra-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: rgba(108, 177, 79, 0.15);
    border: 1px solid rgba(108, 177, 79, 0.3);
    border-radius: var(--radius-sm, 8px);
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.4;
    text-align: center;
  }

  .price-extra-note p {
    margin: 0;
  }

  .price-extra-note .note-icon {
    flex-shrink: 0;
    color: var(--color-primary, #6CB14F);
  }

  .price-footnote {
    font-size: 1.025rem;
    color: #FFFFFF;
    margin-top: 0.5rem;
    margin-bottom: 1.75rem;
    text-align: center;
  }

  .price-footnote strong {
    font-weight: 600;
    color: #FFFFFF;
  }

  .pricing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    align-items: center;
  }

  .pricing-actions :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 200px;
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .pricing-actions :global(.btn) {
      width: 100%;
    }
  }

  .btn-icon {
    flex-shrink: 0;
  }
</style>
