---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/site';

export interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  address?: string;
  zoom?: number;
  height?: string;
  showCard?: boolean;
  class?: string;
}

const {
  badge = 'Localização',
  title = 'Como Chegar',
  subtitle = 'Estamos situados em Caraá, RS, rodeados por mata nativa e nascentes cristalinas.',
  address = siteConfig.contact.address,
  zoom = 10,
  height = 'clamp(520px, 72vh, 720px)',
  showCard = true,
  class: className = '',
} = Astro.props;

const encodedAddress = encodeURIComponent(address);
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodedAddress}&t=m&z=${zoom}&ie=UTF8&iwloc=&output=embed`;
const externalDirectionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodedAddress}`;
---

<section class:list={['map-section', className]}>
  {
    (title || badge) && (
      <div class="container">
        <SectionHeading
          badge={badge}
          title={title || ''}
          subtitle={subtitle}
          class="reveal-on-scroll"
        />
      </div>
    )
  }

  <div class="map-wrapper reveal-on-scroll" style={{ '--map-height': height }}>
    <iframe
      src={mapEmbedUrl}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="eager"
      referrerpolicy="no-referrer-when-downgrade"
      title={`Mapa de localização: ${address}`}
      class="map-iframe"
    ></iframe>

    {
      showCard && (
        <div class="map-floating-card">
          <div class="card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/>
            </svg>
          </div>
          <div class="card-body">
            <h4 class="card-title">Bosque das Águas</h4>
            <p class="card-address">{address}</p>
            <Button
              href={externalDirectionsUrl}
              variant="secondary"
              size="sm"
              target="_blank"
              rel="noopener noreferrer"
              class="directions-btn"
            >
              Abrir no Google Maps
            </Button>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .map-section {
    padding-top: var(--space-8);
    position: relative;
    background-color: var(--color-surface);
  }

  .map-wrapper {
    position: relative;
    width: 100%;
    height: var(--map-height, clamp(520px, 72vh, 720px));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-neutral-light);
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    display: block;
  }

  .map-floating-card {
    position: absolute;
    bottom: var(--space-6);
    left: var(--space-6);
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
    padding: var(--space-5) var(--space-6);
    max-width: 380px;
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    z-index: 5;
    border: 1px solid var(--color-border-subtle);
  }

  @media (max-width: 600px) {
    .map-wrapper {
      height: auto;
      padding-bottom: var(--space-4);
    }

    .map-iframe {
      height: 320px;
    }

    .map-floating-card {
      position: relative;
      bottom: auto;
      left: auto;
      margin: var(--space-4) auto 0;
      max-width: calc(100% - 2rem);
    }
  }

  .card-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background-color: var(--color-neutral-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-title {
    font-size: var(--font-size-base);
    color: var(--color-pine-dark);
    margin-bottom: var(--space-1);
  }

  .card-address {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    line-height: 1.4;
  }

  .directions-btn {
    font-size: var(--font-size-xs);
  }
</style>
