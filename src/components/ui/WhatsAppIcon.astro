---
import { faWhatsapp } from '@fortawesome/free-brands-svg-icons';

interface Props {
  class?: string;
  width?: number;
  height?: number;
}

const { width = 20, height = 20 } = Astro.props;
const [viewWidth, viewHeight, , , pathData] = faWhatsapp.icon;
const paths = Array.isArray(pathData) ? pathData : [pathData];
---

<svg
  {...Astro.props}
  viewBox={`0 0 ${viewWidth} ${viewHeight}`}
  width={width}
  height={height}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {paths.map((path) => <path d={path} />)}
</svg>
